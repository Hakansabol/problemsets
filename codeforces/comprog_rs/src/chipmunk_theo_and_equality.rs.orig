fn operate(n: i32) -> i32 {
    if n % 2 == 0 { n / 2 } else { n + 1 }
}

fn solve() {
    let n = take_int() as usize;
    let v = take_vector();

    let mut storeseq = vec![];
    let mut ans = 0i32;
    let mut matchlen = 1000000;
    let mut onecount = 0;
    for &a in &v {
        // make the sequence
        let mut val = a;
        let mut vseq = vec![];
        if val == 1 {
            onecount += 1;
        }
        while val > 2 {
            vseq.push(val);
            val = operate(val);
            ans += 1;
        }

        if a == v[0] {
            matchlen = std::cmp::min(vseq.len(), matchlen);
            // matchlen = vseq.len();
            storeseq = vseq;
        } else {
            let iterlen = std::cmp::min(storeseq.len(), vseq.len());
            matchlen = std::cmp::min(matchlen, iterlen);
            for i in 1..=iterlen {
                if vseq[vseq.len() - i] != storeseq[storeseq.len() - i] {
                    matchlen = std::cmp::min(matchlen, i - 1);
                    break;
                }
            }
        }
    }

    // println!("{:?}", storeseq);
    println!(
        "{}",
        ans - matchlen as i32 * (n as i32) + std::cmp::min(onecount, n as i32 - onecount)
    );
>>>>>>> dfa71b9 (more cf)
}

pub fn main() {
    for _ in 0..take_int() {
        solve();
    }
